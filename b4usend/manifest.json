{
  "manifest_version": 3,
  "name": "b4usend",
  "description": "Analyzes messages before sending to detect communication signals.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/analyzer.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
